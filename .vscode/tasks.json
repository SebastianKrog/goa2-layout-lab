{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Layout lab: Start",
      "type": "process",
      "command": "node",
      "args": ["launch.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Layout lab: Stop",
      "type": "process",
      "command": "node",
      "args": ["launch.mjs", "--stop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
