# Copy to .env.layout-lab in the layout-lab root (ignored by Git), then:
# npm run compare -- --env-file=.env.layout-lab
# Shell environment wins over this file; CLI ref/preset flags win over both.

GOA2_LAB_BASE_REF=a3c5e0a46b35a42cd6e054512ce3dbc6a61a579c
GOA2_LAB_SCRIPT_REF=ad1eed5427b91b8daaebb56c4ceafda01db5f7de
GOA2_LAB_COMPARATOR_REF=mobile-migration
GOA2_LAB_PRESET=current
GOA2_LAB_DISPLAY=embedded

# Optional runtime/path overrides. Leave unset to detect the local platform.
# GOA2_LAB_RUNTIME=native
# GOA2_LAB_WSL_DISTRO=Ubuntu
# GOA2_LAB_FRONTEND=../goa2-frontend
# GOA2_LAB_BACKEND=../goa2-backend
# For Random/Simple/ISMCTS opponents in desk or device views, use the bots-upstream checkout instead:
# GOA2_LAB_BACKEND=../goa2-backend-bots
# GOA2_LAB_PATCH=../goa2-mobile-2d-patch

# Ports must be distinct. Use the same settings for --stop.
GOA2_LAB_DESK_PORT=3200
GOA2_LAB_BASE_PORT=3101
GOA2_LAB_COMPARATOR_PORT=3100
GOA2_LAB_LIVE_PORT=3102
GOA2_LAB_BACKEND_PORT=8100

# Optional device-view gateway (the desk itself stays on localhost)
# GOA2_LAB_DEVICE_PORT=3300
# GOA2_LAB_DEVICE_HOST=192.168.0.13
